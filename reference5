#include <iostream>
using namespace std;

void setFirstToZero(int arr[]) {
    arr[0] = 0;        
}

void incrementAll(int (&arr)[4]) {
    for (int i = 0; i < 4; ++i) {
        arr[i] += 1;   
    }
}

void setLastToTen(int& x) {
    x = 10;        
}

int main() {
    int nums1[4] = {1, 2, 3, 4};
    setFirstToZero(nums1);
    incrementAll(nums1);
    cout << nums1[0] << " "
         << nums1[1] << " "
         << nums1[2] << " "
         << nums1[3] << endl;

    // output: 1 3 4 5


    int nums2[4] = {3, 5, 7, 9};
    setLastToTen(nums2[3]);   
    for (int i = 0; i < 4; ++i) {
        cout << nums2[i] << " ";
    }
    cout << endl;

    // output: 3 5 7 10

    return 0;
}