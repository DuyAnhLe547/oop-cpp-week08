#include <iostream>
#include <string>
using namespace std;

int main(){

    string text = "Hello World!";
    string insertText = "C++ ";
    int pos = 6;
    text.insert(pos, insertText);
    cout << text << endl;


    string text1;
    string subString;
    cout << "Enter text1: ";
    getline(cin, text1);
    cout << "Enter substring: ";
    getline(cin, subString);
    size_t pos = text1.find(subString);
    if (pos != string::npos) {
        cout << "Position: " << pos << endl;
    }
    else {
        cout << "Substring not found!" << endl;
    }



    string text2;
    cout << "Enter text2: ";
    getline(cin, text2);
    int countAll = text2.length();
    int countwithoutspace = 0;
    for (int i = 0; i < text2.length(); i++) {
        if (text2[i] != ' ') {
            countwithoutspace++;
        }
    }
    cout << "Count all characters: " << countAll << endl;
    cout << "Count without spaces: " << countwithoutspace << endl;



    string text4 = "I like Java";
    string oldText = "Java";
    string newText = "C++";
    size_t pos = text4.find(oldText);
    if (pos != string::npos) {
        text4.replace(pos, oldText.length(), newText);
    }
    cout << text4 << endl;
    
    

    string text5 = "Computer Science";
    int start = 9;
    int length = 7;
    string result = text5.substr(start, length);
    cout << result << endl;

    return 0;

}