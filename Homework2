#include <iostream>
#include <string>
using namespace std;
#define MAX 50


struct phone{
    int id;
    string brand;
    int version;
    int year;
    double cost;
    int series;

};

struct order{
    int idOrder;
    int idCustomer;
    int OrderItem;
    int date;
};

struct Shop{
    phone p[MAX];
    order o[50];

    int lenMobile = 0;
    int lenOrder = 0;
    

    int ThemMobile(){
        phone x;
        if (lenMobile >= MAX){
            cout << "danh sach day";
            return 0;
        }
        
        cout << "Nhap ID: ";
        cin >> x.id;

        cout << "Nhap brand: ";
        cin >> x.brand;

        cout << "Nhap version: ";
        cin >> x.version;

        cout << "Nhap series: ";
        cin >> x.series;

        cout << "Nhap year: ";
        cin >> x.year;

        cout << "Nhap cost: ";
        cin >> x.cost;

        p[lenMobile] = x;
        lenMobile++;

    }

    void XoaMobile(){
        int id;
        cout << "Nhap ID dien thoai can xoa: ";
        cin >> id;

        int pos = -1;

        for (int i = 0; i < lenMobile; i++)
        {
            if (p[i].id == id)
            {
                pos = i;
                break;
            }
        }

        if (pos == -1)
        {
            cout << "Khong tim thay\n";
            return;
        }

        for (int i = pos; i < lenMobile - 1; i++){
            p[i] = p[i + 1];
        }
        lenMobile--;
    }

    void TaoOrder(){
        order x;
         if (lenOrder >= MAX)
        {
        cout << "danh sach order day\n";
        return;
        }

        cout << "Nhap ID order: ";
        cin >> x.idOrder;

        cout << "Nhap ID customer: ";
        cin >> x.idCustomer;

        cout << "Nhap ID/order item: ";
        cin >> x.OrderItem;

        cout << "Nhap thang: ";
        cin >> x.date;

        o[lenOrder] = x;
        lenOrder++;
    }

    void ChinhOrder(){
        int id;
    cout << "Nhap ID order can sua: ";
    cin >> id;

    int pos = -1;

    for (int i = 0; i < lenOrder; i++)
    {
        if (o[i].idOrder == id)
        {
            pos = i;
            break;
        }
    }

    if (pos == -1)
    {
        cout << "Khong tim thay order!\n";
        return;
    }


    cout << "Nhap ID customer moi: ";
    cin >> o[pos].idCustomer;

    cout << "Nhap item moi: ";
    cin >> o[pos].OrderItem;

    cout << "Nhap thang moi: ";
    cin >> o[pos].date;
    }

    void ThongkeOrder(){
        int date;
        int count = 0;

        cout << "Nhap thang can thong ke: ";
        cin >> date;

        for (int i = 0; i < lenOrder; i++)
        {
            if (o[i].date == date)
            {
                count++;
            }
        }

        cout << "So order trong thang "
            << date << ": "
            << count << endl;
        }
    };



int main(){
    Shop s;
    
    s.ThemMobile();

    s.XoaMobile();

    s.TaoOrder();

    s.ChinhOrder();

    s.ThongkeOrder();

    return 0;
    
}